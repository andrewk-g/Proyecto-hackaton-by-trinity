# Copiar a .env (cp .env.example .env). Todo es opcional: estos son los valores por defecto.

# IA local (Ollama). No requiere API key.
# Sin GPU puede usarse un modelo más liviano: AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b

# Carpeta con los CSV a importar (ficticios por defecto; para el evento, los oficiales)
DATA_DIR=data/ejemplo
